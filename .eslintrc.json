{
	"extends": [
		"eslint:recommended",
		"next/core-web-vitals",
		"next/typescript",
		"plugin:storybook/recommended",
		"plugin:prettier/recommended"
	],
	"plugins": ["react-hooks", "prettier"],
	"rules": {
		"prettier/prettier": "error",
		"indent": "off",
		"quotes": "off",
		"semi": "off",
		"react-hooks/exhaustive-deps": "warn",
		"no-console": "warn"
	}
}
